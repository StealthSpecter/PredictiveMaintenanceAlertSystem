never missed_critical_alerts {    /* !([] ((! (((pred_count>0)) && ((predictions[0]>80)))) || (<> ((alerts[equipment_ids[0]]==1))))) */
T0_init:
	do
	:: (! ((! (((pred_count>0)) && ((predictions[0]>80))))) && ! (((alerts[equipment_ids[0]]==1)))) -> goto accept_S4
	:: (1) -> goto T0_init
	od;
accept_S4:
	do
	:: (! (((alerts[equipment_ids[0]]==1)))) -> goto accept_S4
	od;
}
never false_alerts {    /* !([] (! ((((pred_count>0)) && ((alerts[0]==1))) && ((predictions[0]<30))))) */
T0_init:
	do
	:: atomic { (! ((! ((((pred_count>0)) && ((alerts[0]==1))) && ((predictions[0]<30)))))) -> assert(!(! ((! ((((pred_count>0)) && ((alerts[0]==1))) && ((predictions[0]<30))))))) }
	:: (1) -> goto T0_init
	od;
accept_all:
	skip
}
